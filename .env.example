# ==============================================================================
# SentinelX Root Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Option A: Combined URL for Supabase/Render Cloud DB)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Database Connection (Option B: Individual parameters for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelx
DB_USER=postgres
DB_PASSWORD=

# Security & CORS (Allowed Frontend Origins)
CORS_ORIGIN=http://localhost:5173,https://your-sentinelx.vercel.app

# Optional Ingestion Security Token (Protects Linux log shipper endpoints)
LOG_INGESTION_TOKEN=

# AI Engine (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Frontend API Target
VITE_API_URL=http://localhost:5000/api
