# ==============================================================================
# SentinelX Backend Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

PORT=5000
NODE_ENV=development

# Cloud Database URL (Supabase PostgreSQL / Render)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=

# Local PostgreSQL Configuration (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelx
DB_USER=postgres
DB_PASSWORD=

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Log Ingestion Protection (Optional token required by Ubuntu VM shipper)
LOG_INGESTION_TOKEN=

# OpenRouter AI Engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
